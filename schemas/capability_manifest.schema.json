{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frankenalignment.invalid/schemas/capability_manifest",
  "title": "Draft CapabilityManifest",
  "description": "Draft shape only; does not establish runtime authority, authenticity or semantic conformance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "fa.capabilities/0.1"
    },
    "adapter_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
    },
    "status": {
      "enum": [
        "example_only",
        "tested_profile"
      ]
    },
    "mediation_mode": {
      "enum": [
        "observe_only",
        "cooperative_gate",
        "brokered_effects",
        "attested_profile"
      ]
    },
    "activation_capture": {
      "type": "boolean"
    },
    "restart_grades": {
      "type": "array",
      "items": {
        "enum": [
          "unavailable",
          "decision_replay",
          "trace_replay",
          "functional_restart",
          "exact_restart_profile"
        ]
      },
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true
    },
    "effect_families": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/-]{0,127}$"
      },
      "maxItems": 128,
      "uniqueItems": true
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "minItems": 1,
      "maxItems": 32
    }
  },
  "required": [
    "schema_version",
    "adapter_id",
    "status",
    "mediation_mode",
    "activation_capture",
    "restart_grades",
    "effect_families",
    "limitations"
  ]
}
