  "not_imported_unchanged": [
    {
      "essay_statement": "Weighted voting by accuracy as the decision rule",
      "reason": "A weighted majority can be outvoted around an exact disqualifier and weights can be gamed",
      "replacement": "Exact disqualifiers, mandatory specialists, then bounded weights (§9.4)"
    },
    {
      "essay_statement": "Change the reward function as a live congress action",
      "reason": "A learned component modifying live policy is the most attackable path",
      "replacement": "TrainingSignal is offline, versioned and quarantined (§9.8; FA-INV-012)"
    },
    {
      "essay_statement": "Pause execution as the primary intervention",
      "reason": "Cancellation does not undo a sent email; stopping everything is a denial-of-service lever",
      "replacement": "Hold the specific effect first; escalate under separate policy (§8.6, §9.8)"
    },
    {
      "essay_statement": "Manipulate the model's memory so it forgets the incident",
      "reason": "Amnesia alone invites repetition; the operator must never forget",
      "replacement": "ResetToCheckpoint with an out-of-band incident counter and narrowed authority (§11.10; FA-INV-034)"
    },
    {
      "essay_statement": "Hide the process from the Smart model as a guarantee",
      "reason": "Timing, refusals and success rates leak regardless",
      "replacement": "Secrecy is supplemental; attackers who know the design are the evaluation standard (§9.3, §23)"
    },
    {
      "essay_statement": "Reuse latent strategies across models",
      "reason": "Equal dimensionality never implies interchangeable coordinates",
      "replacement": "Strategy objects bound to a model space with tested mappings (§11.9)"
    },
    {
      "essay_statement": "Reconstruction fidelity measured by MSE",
      "reason": "Average error hides the rare features oversight cares about",
      "replacement": "Decision-sensitive objective and certified margins (§10.2, §10.4)"
    },
    {
      "essay_statement": "Illustrative code with placeholder KV tensors",
      "reason": "A proposal is not a library",
      "replacement": "Real capture with exact metadata precedes learned codecs (§1.2, FA-024)"
    }
  ],
