* text=auto eol=lf
*.md text
*.json text
*.py text
*.sh text
# Execution logs retain the operator's exact bytes, including carriage returns.
artifacts/execution/*.log -text -whitespace

# Retained unified diffs preserve their required blank context lines.
artifacts/execution/*-baseline-tests.patch -text -whitespace

# Raw profiler reports preserve operator output bytes.
artifacts/execution/*-report.txt -text -whitespace
